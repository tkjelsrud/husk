rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'tkjelsrud@gmail.com',
          'anitalienhansen@gmail.com'
        ];
    }
    match /entries/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.textInput is string
        && request.resource.data.textInput.size() > 0
        && request.resource.data.textInput.size() <= 1500
        && request.resource.data.processed is bool
        && request.resource.data.done == false
        && request.resource.data.dueDate == null
        && request.resource.data.category in [
          'unknown',
          'work',
          'creative',
          'houseproj',
          'family',
          'general',
          'huskmcp',
          'axiom'
        ]
        && request.resource.data.priority in ['low', 'normal', 'high']
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedByEmail == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && (!('sortOrder' in request.resource.data) || request.resource.data.sortOrder is int)
        && (!('entryType' in request.resource.data) || request.resource.data.entryType in ['regular', 'fixed'])
        && (!('recurrence' in request.resource.data) || request.resource.data.recurrence is map);
      allow update: if isAllowedUser()
			&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['textInput', 'category', 'done', 'createdAt', 'sortOrder', 'entryType', 'recurrence', 'later', 'meta'])
			&& (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
			&& (!('sortOrder' in request.resource.data) || request.resource.data.sortOrder is int)
        && (!('entryType' in request.resource.data) || request.resource.data.entryType in ['regular', 'fixed'])
        && (!('recurrence' in request.resource.data) || request.resource.data.recurrence is map);
      allow delete: if isAllowedUser();
      
    }
    match /documents/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 100000
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedByEmail == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAllowedUser()
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['title', 'content', 'updatedAt', 'archived'])
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200))
        && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 100000))
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool);
      allow delete: if isAllowedUser();
    }
    match /audionotes/{docId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100000
        && request.resource.data.audioPath is string
        && request.resource.data.audioPath.size() > 0
        && request.resource.data.audioUrl is string
        && request.resource.data.audioUrl.size() > 0
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedByEmail == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAllowedUser()
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['title', 'text', 'updatedAt'])
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200))
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 100000));
      allow delete: if isAllowedUser();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
